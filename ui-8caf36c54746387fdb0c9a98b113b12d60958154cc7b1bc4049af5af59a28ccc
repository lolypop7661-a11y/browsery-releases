// Runs in Gecko content processes for every page in a Browsery tab.
//  - Ad blocker: hides leftover ad slots with a user stylesheet and runs the
//    same anti-adblock and YouTube page code as the Electron build
//    (generated into content-rules.sys.mjs from webview-content-preload.cjs).
//  - Page tools for the interface: executeJavaScript, insertCSS, title/icons.
import { GENERIC_HIDE, YOUTUBE_HIDE, PRELUDE, ANTI_DETECTION, YOUTUBE } from 'resource://browsery/actors/content-rules.sys.mjs';
import { GOOGLE_SKIN, GOOGLE_RECOLOR, GOOGLE_STRIP, isGoogleSearch, webOnlyUrl } from 'resource://browsery/actors/google-skin.sys.mjs';
import { fixWord } from 'resource://browsery/actors/typos.sys.mjs';
import { setTimeout } from 'resource://gre/modules/Timer.sys.mjs';

// Sites whose text boxes did not follow a typing fix (see fixTypoNow); left alone from then on.
const HANDS_OFF = new Set();
const YT_HOST = /(?:^|\.)youtube(?:-nocookie)?\.com$/;
const VIRTUAL_MARK = '#browsery-virtual=';
// JS built-ins inside a sandbox are the sandbox's own; page patches must use
// the page's, so pull them off the window first.
const PAGE_BUILTINS = 'const { JSON, Function, Proxy, WeakMap, Reflect, Object, Number } = window;';

// Web pages run in content processes, which are not given text preferences (Firefox
// keeps them from web content). The Browsery window copies the few this actor reads
// into the processes' shared data (platform/shared-prefs.js); straight from the
// preference only where it can be read (the parent process).
function stringPref(name, fallback = '') {
  try { const shared = Services.cpmm?.sharedData?.get(`pref:${name}`); if (typeof shared === 'string') return shared; } catch {}
  try { return Services.prefs.getStringPref(name, fallback); } catch { return fallback; }
}

function adblockOn(host) {
  try {
    if (!Services.prefs.getBoolPref('browsery.content.adblock', true)) return false;
    const allowed = stringPref('browsery.content.allowlist', '').split(',').map(item => item.trim()).filter(Boolean);
    return !allowed.some(site => host === site || host.endsWith(`.${site}`));
  } catch { return false; }
}

// Darken every site: the page is inverted and turned round the colour wheel, which keeps
// hues and turns white to near-black; pictures, video and canvases are turned back.
const DARK_CSS = `html { filter: invert(1) hue-rotate(180deg) brightness(.94) contrast(.94) !important; background: #fff !important; }
img, video, picture, canvas, iframe, embed, object, svg image, [style*="background-image"], :fullscreen { filter: invert(1) hue-rotate(180deg) !important; }
picture img { filter: none !important; }`;

// Hide parts of a page: what someone picks stays hidden on that site. The rules are
// CSS selectors in browsery.content.hidden ({ "site": [selectors] }), applied as a user
// sheet so a page's own styles can't bring them back.
const HIDDEN_PREF = 'browsery.content.hidden';
const PICKER_CSS = `.box { position: fixed; z-index: 2147483647; pointer-events: none; display: none; box-sizing: border-box; border: 2px solid #ff4f6d; border-radius: 5px; background: rgba(255, 79, 109, .14); box-shadow: 0 0 0 1px rgba(255, 255, 255, .5), 0 8px 30px rgba(255, 79, 109, .25); transition: left .09s ease-out, top .09s ease-out, width .09s ease-out, height .09s ease-out; }
.label { position: fixed; z-index: 2147483647; pointer-events: none; display: none; max-width: 60vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 4px 9px; border-radius: 6px; background: #ff4f6d; color: #fff; font: 600 12px/1.35 system-ui, -apple-system, "Segoe UI", sans-serif; box-shadow: 0 6px 18px rgba(0, 0, 0, .25); }
.label i { font-style: normal; font-weight: 400; opacity: .85; }`;

// A short CSS selector for one element: an id or classes that look hand-written,
// with positions only where needed, from the element up until it is unique.
function selectorFor(el, win) {
  const doc = el.ownerDocument;
  const esc = text => win.CSS.escape(text);
  const unique = sel => { try { return doc.querySelectorAll(sel).length === 1; } catch { return false; } };
  const stable = name => name && name.length < 40 && !/\d{4,}|^[a-f0-9]{6,}$|[_-](?=[a-z]*\d)[a-z0-9]{5,}$/i.test(name) && !/^(is|has)-|active|hover|focus|open|selected|visible/i.test(name);
  const parts = [];
  let node = el;
  for (let depth = 0; node && node.nodeType === 1 && node.localName !== 'html' && node.localName !== 'body' && depth < 8; depth++) {
    if (node.id && stable(node.id)) {
      parts.unshift(`#${esc(node.id)}`);
      if (unique(parts.join(' > '))) return parts.join(' > ');
      node = node.parentElement; continue;
    }
    let part = node.localName;
    const classes = [...node.classList].filter(stable).slice(0, 3);
    if (classes.length) part += classes.map(name => `.${esc(name)}`).join('');
    const parent = node.parentElement;
    if (parent && !unique([part, ...parts].join(' > '))) {
      const same = [...parent.children].filter(child => child.localName === node.localName);
      if (same.length > 1) part += `:nth-of-type(${same.indexOf(node) + 1})`;
    }
    parts.unshift(part);
    if (unique(parts.join(' > '))) return parts.join(' > ');
    node = parent;
  }
  return parts.join(' > ');
}

export class BrowseryPageChild extends JSWindowActorChild {
  constructor() {
    super();
    this.sheets = new Map();
    this.sandbox = null;
    this.protectedPage = false;
    this.skinned = false;
    this.recolored = false;
    this.stripped = false;
  }

  get pageSandbox() {
    if (!this.sandbox) {
      const win = this.contentWindow;
      this.sandbox = Cu.Sandbox(win, { sandboxPrototype: win, wantXrays: false, sameZoneAs: win, sandboxName: 'Browsery page tools' });
    }
    return this.sandbox;
  }

  // Browsery's own pages (search) are data: documents tagged by the Browsery
  // window; they get two functions to reach the search service. Only in the
  // top frame: web pages can't open top-level data: documents themselves.
  exposeBrowseryPage() {
    if (this.browsingContext.parent) return;
    const win = this.contentWindow;
    const address = String(this.document?.documentURI || '');
    if (!win || !address.startsWith('data:text/html') || !address.includes(VIRTUAL_MARK)) return;
    Cu.exportFunction((path, search) => new win.Promise((resolve, reject) => {
      this.sendQuery('Browsery:SearchCall', { path: String(path || ''), search: String(search || '') })
        .then(result => resolve(Cu.cloneInto(result, win)), error => reject(new win.Error(String(error?.message || error))));
    }), win, { defineAs: 'browserySearch' });
    Cu.exportFunction(url => { this.sendAsyncMessage('Browsery:Open', { url: String(url || '') }); }, win, { defineAs: 'browseryOpen' });
  }

  // Browsery v2 offers to save a password when someone signs in. Listeners
  // are the actor's own (pages can't see or remove them); only the top frame
  // of http(s) pages, and only when the app asked for it.
  watchLogins() {
    if (this.loginWatch || this.browsingContext.parent) return;
    try { if (!Services.prefs.getBoolPref('browsery.content.loginCapture', false)) return; } catch { return; }
    const doc = this.document;
    const win = this.contentWindow;
    if (!doc || !win || !/^https?:$/.test(win.location.protocol)) return;
    this.loginWatch = true;
    let lastSent = '';
    const visible = input => { try { const rect = input.getBoundingClientRect(); return rect.width > 0 && rect.height > 0 && !input.disabled; } catch { return false; } };
    const capture = scope => {
      const root = scope && scope.querySelectorAll ? scope : doc;
      const passwords = [...root.querySelectorAll('input[type="password"]')].filter(input => input.value && visible(input));
      const password = passwords[0] || [...doc.querySelectorAll('input[type="password"]')].find(input => input.value && visible(input));
      if (!password) return;
      const fields = [...(password.form || doc).querySelectorAll('input')];
      const before = fields.slice(0, fields.indexOf(password)).reverse();
      const isName = input => ['text', 'email', 'tel', ''].includes((input.type || 'text').toLowerCase()) && input.value && input.value.length < 200;
      const user = before.find(isName) || fields.find(isName);
      const username = user ? user.value.trim() : '';
      const key = `${win.location.origin}|${username}|${password.value.length}`;
      if (!username || key === lastSent) return;
      lastSent = key;
      this.sendAsyncMessage('Browsery:LoginCapture', { origin: win.location.origin, username: username.slice(0, 256), password: password.value.slice(0, 1024) });
    };
    doc.addEventListener('submit', event => capture(event.target), true);
    doc.addEventListener('click', event => {
      const button = event.target?.closest?.('button, input[type="submit"], [role="button"]');
      if (button) win.setTimeout(() => capture(button.form || null), 0);
    }, true);
    doc.addEventListener('keydown', event => { if (event.key === 'Enter' && event.target?.type === 'password') capture(event.target.form || null); }, true);
  }

  // Link hover (for the status line) and Alt+click (opens the link in a
  // floating glance card) — top-level documents only.
  watchLinks() {
    if (this.linkWatch || this.browsingContext.parent) return;
    const doc = this.document;
    const win = this.contentWindow;
    if (!doc || !win) return;
    this.linkWatch = true;
    let last = '';
    const linkOf = target => { try { const a = target?.closest?.('a[href]'); return a ? String(a.href || '') : ''; } catch { return ''; } };
    doc.addEventListener('mouseover', event => {
      const url = linkOf(event.target);
      if (url === last) return;
      last = url;
      this.sendAsyncMessage('Browsery:LinkHover', { url: url.slice(0, 2000) });
    }, true);
    doc.addEventListener('mouseleave', () => { if (last) { last = ''; this.sendAsyncMessage('Browsery:LinkHover', { url: '' }); } }, true);
    doc.addEventListener('click', event => {
      if (!event.altKey || event.button !== 0) return;
      const url = linkOf(event.target);
      if (!/^https?:/.test(url)) return;
      event.preventDefault();
      event.stopPropagation();
      this.sendAsyncMessage('Browsery:Glance', { url: url.slice(0, 2000), x: Math.round(event.clientX), y: Math.round(event.clientY) });
    }, true);
  }

  // ----- Darken every site (Settings › Appearance › Websites) -----
  // Pages that are light get turned dark with a filter; pictures and video are turned
  // back so they keep their colours. Sites with their own dark look (or that are dark
  // already) are left alone. Per site: browsery.content.darkOn / darkOff (host lists).
  darkWanted() {
    const win = this.contentWindow;
    let host = '';
    try { if (!/^https?:$/.test(win.location.protocol)) return false; host = win.location.hostname.replace(/^www\./, ''); } catch { return false; }
    const list = name => stringPref(name, '').split(',').map(item => item.trim()).filter(Boolean);
    if (list('browsery.content.darkOff').includes(host)) return false;
    if (list('browsery.content.darkOn').includes(host)) return true;
    try { return Services.prefs.getBoolPref('browsery.content.forceDark', false); } catch { return false; }
  }

  pageIsLight() {
    const win = this.contentWindow;
    const doc = this.document;
    const rgb = node => { try { const m = String(win.getComputedStyle(node).backgroundColor).match(/[\d.]+/g); return m && (m.length < 4 || Number(m[3]) > 0.1) ? m.slice(0, 3).map(Number) : null; } catch { return null; } };
    const colour = (doc.body && rgb(doc.body)) || rgb(doc.documentElement) || [255, 255, 255];
    const light = (0.2126 * colour[0] + 0.7152 * colour[1] + 0.0722 * colour[2]) / 255;
    return light > 0.55;
  }

  darken(force) {
    if (this.browsingContext.parent) return;
    const win = this.contentWindow;
    if (!win?.windowUtils) return;
    const want = force ?? this.darkWanted();
    const uri = `data:text/css;charset=utf-8,${encodeURIComponent(DARK_CSS)}`;
    if (this.darkened && !want) { try { win.windowUtils.removeSheetUsingURIString(uri, Ci.nsIDOMWindowUtils.AUTHOR_SHEET); } catch {} this.darkened = false; }
    if (!this.darkened && want && (force || this.pageIsLight())) { try { win.windowUtils.loadSheetUsingURIString(uri, Ci.nsIDOMWindowUtils.AUTHOR_SHEET); this.darkened = true; } catch {} }
  }

  // ----- Hide parts of a page -----
  siteName() {
    try { const win = this.contentWindow; return /^https?:$/.test(win.location.protocol) ? win.location.hostname.replace(/^www\./, '') : ''; } catch { return ''; }
  }

  hiddenFor(host, all) {
    let rules = all;
    if (!rules) { try { rules = JSON.parse(stringPref(HIDDEN_PREF, '{}')); } catch { rules = {}; } }
    return Array.isArray(rules?.[host]) ? rules[host].map(String) : [];
  }

  applyHidden(extra = [], all = null) {
    if (this.browsingContext.parent) return;
    const win = this.contentWindow;
    const host = this.siteName();
    if (!win?.windowUtils || !host) return;
    const rules = [...new Set([...this.hiddenFor(host, all), ...extra])].filter(rule => rule && rule.length < 600 && !/[{}<]/.test(rule));
    if (this.hiddenSheet) { try { win.windowUtils.removeSheetUsingURIString(this.hiddenSheet, Ci.nsIDOMWindowUtils.USER_SHEET); } catch {} this.hiddenSheet = ''; }
    if (!rules.length) return;
    // one rule per selector, so a selector this engine can't read only drops itself
    const uri = `data:text/css;charset=utf-8,${encodeURIComponent(rules.map(rule => `${rule} { display: none !important; }`).join('\n'))}`;
    try { win.windowUtils.loadSheetUsingURIString(uri, Ci.nsIDOMWindowUtils.USER_SHEET); this.hiddenSheet = uri; } catch {}
  }

  // The picker: what is under the pointer is outlined; a click hides it, ↑ and ↓ pick
  // a bigger or smaller part, Esc stops. The outline lives in the page's anonymous
  // content, out of reach of the page's own scripts and styles.
  startPicker() {
    if (this.picker) return { ok: true, host: this.siteName() };
    if (this.browsingContext.parent) return { ok: false };
    const win = this.contentWindow;
    const doc = this.document;
    const host = this.siteName();
    if (!win || !doc?.documentElement || !host) return { ok: false };
    const make = cls => { const el = doc.createElement('div'); el.className = cls; return el; };
    const style = doc.createElement('style'); style.textContent = PICKER_CSS;
    const box = make('box'); const label = make('label');
    let anon = null, holder = null;
    try { anon = doc.insertAnonymousContent(); anon.root.append(style, box, label); }
    catch {
      anon = null;
      holder = doc.createElement('browsery-picker');
      const root = holder.attachShadow({ mode: 'closed' });
      root.append(style, box, label);
      doc.documentElement.append(holder);
    }
    const picker = { anon, holder, box, label, chain: [], added: [], x: 0, y: 0 };
    this.picker = picker;
    const usable = el => el && el.nodeType === 1 && el.localName !== 'html' && el.localName !== 'body' && el !== holder;
    const show = el => {
      if (!usable(el)) { box.style.display = label.style.display = 'none'; return; }
      const r = el.getBoundingClientRect();
      Object.assign(box.style, { display: 'block', left: `${r.left - 2}px`, top: `${r.top - 2}px`, width: `${r.width + 4}px`, height: `${r.height + 4}px` });
      const name = `${el.localName}${el.id ? `#${el.id}` : ''}${[...el.classList].slice(0, 2).map(c => `.${c}`).join('')}`;
      label.textContent = '';
      label.append(doc.createTextNode(name.slice(0, 60)));
      const size = doc.createElement('i'); size.textContent = `  ${Math.round(r.width)} × ${Math.round(r.height)}`;
      label.append(size);
      const above = r.top > 30;
      Object.assign(label.style, { display: 'block', left: `${Math.max(4, Math.min(r.left, win.innerWidth - 260))}px`, top: `${above ? r.top - 28 : Math.min(r.bottom + 6, win.innerHeight - 28)}px` });
    };
    const current = () => picker.chain[picker.chain.length - 1] || null;
    const pointAt = (x, y) => {
      picker.x = x; picker.y = y;
      const el = doc.elementFromPoint(x, y);
      picker.chain = usable(el) ? [el] : [];
      show(current());
    };
    const block = event => { event.preventDefault(); event.stopImmediatePropagation(); };
    const handlers = {
      mousemove: event => pointAt(event.clientX, event.clientY),
      scroll: () => show(current()),
      click: event => {
        block(event);
        const el = current();
        if (!usable(el)) return;
        const selector = selectorFor(el, win);
        if (!selector) return;
        picker.added.push(selector);
        this.applyHidden(picker.added);
        this.sendAsyncMessage('Browsery:Hide', { selector });
        win.setTimeout(() => pointAt(picker.x, picker.y), 30);
      },
      keydown: event => {
        if (event.key === 'Escape') { block(event); this.stopPicker(); this.sendAsyncMessage('Browsery:PickDone', {}); return; }
        if (event.key === 'ArrowUp') { block(event); const el = current(); const up = el?.parentElement; if (usable(up)) { picker.chain.push(up); show(up); } return; }
        if (event.key === 'ArrowDown') { block(event); if (picker.chain.length > 1) { picker.chain.pop(); show(current()); } }
      },
    };
    for (const type of ['mousedown', 'mouseup', 'pointerdown', 'pointerup', 'auxclick', 'dblclick', 'contextmenu', 'submit']) handlers[type] = block;
    picker.off = () => {
      for (const [type, handler] of Object.entries(handlers)) win.removeEventListener(type, handler, true);
    };
    for (const [type, handler] of Object.entries(handlers)) win.addEventListener(type, handler, { capture: true, passive: false });
    return { ok: true, host };
  }

  stopPicker() {
    const picker = this.picker;
    if (!picker) return;
    this.picker = null;
    try { picker.off(); } catch {}
    try { if (picker.anon) this.document.removeAnonymousContent(picker.anon); } catch {}
    try { picker.holder?.remove(); } catch {}
  }

  didDestroy() { this.stopPicker(); }

  // ----- Mouse gestures: hold the right button and draw a stroke -----
  // ← back, → forward, ↑ new tab, ↓ reload. Off unless browsery.content.gestures is on.
  watchGestures() {
    if (this.gestureWatch || this.browsingContext.parent) return;
    try { if (!Services.prefs.getBoolPref('browsery.content.gestures', false)) return; } catch { return; }
    const doc = this.document;
    if (!doc) return;
    this.gestureWatch = true;
    let start = null;
    let swallow = false;
    doc.addEventListener('mousedown', event => { if (event.button === 2) { start = { x: event.screenX, y: event.screenY }; swallow = false; } }, true);
    doc.addEventListener('mouseup', event => {
      if (event.button !== 2 || !start) return;
      const dx = event.screenX - start.x;
      const dy = event.screenY - start.y;
      start = null;
      if (Math.hypot(dx, dy) < 48) return;
      const dir = Math.abs(dx) > Math.abs(dy) ? (dx < 0 ? 'left' : 'right') : (dy < 0 ? 'up' : 'down');
      swallow = true;
      this.sendAsyncMessage('Browsery:Gesture', { dir });
    }, true);
    doc.addEventListener('contextmenu', event => { if (swallow) { swallow = false; event.preventDefault(); event.stopPropagation(); } }, true);
  }

  // ----- A video in its own small window -----
  // The playing (or largest) video on the page; its picture is sent to the window
  // frame by frame by the Browsery window (see platform/tools.js popOutVideo).
  findVideo() {
    const doc = this.document;
    const videos = [...doc.querySelectorAll('video')].filter(video => video.readyState > 1 || video.currentSrc);
    if (!videos.length) return null;
    const area = video => { const r = video.getBoundingClientRect(); return r.width * r.height; };
    return videos.find(video => !video.paused) || videos.sort((a, b) => area(b) - area(a))[0];
  }

  // A form was sent with a field left empty or filled in wrongly (required, type=email,
  // min/max…). Firefox shows the field's message in a bubble its own window draws;
  // Browsery's window has no such bubble, so the message goes to the interface, which
  // shows it. (Gecko's own code has already put the cursor in the field.)
  reportInvalid(elements) {
    try {
      for (const element of elements || []) {
        if (!element || element.ownerDocument?.defaultView !== this.contentWindow) continue;
        const message = String((element.internals?.validationMessage ?? element.validationMessage) || '').trim();
        if (!message) continue;
        this.sendAsyncMessage('Browsery:Invalid', { message: message.slice(0, 200) });
        return;
      }
    } catch {}
  }

  // Typing slips put right as you type (Settings › General › Fix typos as you type): "teh "
  // becomes "the " when the word is finished with a space or a mark. Only words on the short
  // list in typos.sys.mjs, only in ordinary text boxes and message boxes (typoField says
  // which). The change goes through the page's own editing, so the page is told and Ctrl Z
  // puts back what was typed; a word put back that way is not touched again on this page.
  //
  // Chat and mail sites keep their own copy of the text, apart from the screen, and send
  // their copy. Three rules keep the two in step (qa/test_typos.py types into the real
  // editors to hold them): the change is made a moment after the key, not during it; the
  // word and the mark after it are typed over in one go; and a site that still does not
  // follow is left alone from then on.
  fixTypo(event) {
    try {
      this.typoStep = (this.typoStep || 0) + 1;
      if (event.isComposing || this.typosOff) return;
      // the box itself, also when it sits inside a web component
      const field = event.composedTarget || event.target;
      if (event.inputType === 'historyUndo') { this.typoUndone(); return; }
      if (event.inputType !== 'insertText' || typeof event.data !== 'string' || !/^[\s.,!?;:)]$/.test(event.data)) return;
      if (!Services.prefs.getBoolPref('browsery.content.autocorrect', true)) return;
      if (!field?.ownerDocument?.defaultView || !this.typoField(field)) return;
      if (HANDS_OFF.has(field.ownerDocument.location.host)) { this.typosOff = true; return; }
      // Not in the middle of the keystroke: a site that keeps its own copy of the text (chat
      // and mail editors do) is part-way through taking the key in at this point, and a
      // change now can leave its copy and the screen disagreeing. A moment later it has
      // settled. If more has been typed by then, the word is left as it is.
      const step = this.typoStep;
      const mark = event.data;
      setTimeout(() => { if (step === this.typoStep) this.fixTypoNow(field, mark); }, 0);
    } catch {}
  }

  fixTypoNow(field, mark) {
    try {
      if (!field.isConnected || this.typosOff) return;
      const doc = field.ownerDocument;
      const win = doc.defaultView;
      const plain = field.localName === 'input' || field.localName === 'textarea';
      let node = null; let end = 0; let text = '';
      if (plain) {
        end = field.selectionStart;
        if (end == null || end !== field.selectionEnd) return;
        text = field.value;
      } else {
        const selection = win.getSelection();
        if (!selection?.isCollapsed) return;
        node = selection.anchorNode;
        if (!node || node.nodeType !== 3 || !field.contains(node)) return;
        end = selection.anchorOffset;
        text = node.data;
      }
      // the caret has to be where the mark was just typed
      const typed = text[end - 1];
      if (typed !== mark && !(mark === ' ' && typed === '\u00a0')) return;
      // the word that was just finished: everything between the last gap and the mark typed
      const found = text.slice(Math.max(0, end - 40), end - 1).match(/(?:^|[\s("\u00a0])([A-Za-z][A-Za-z']{2,23})$/);
      if (!found || end < 4) return;
      const word = found[1];
      const fixed = fixWord(word);
      if (!fixed || this.typosKept?.has(word.toLowerCase())) return;
      const from = end - 1 - word.length;
      if (text.slice(from, end - 1) !== word) return;
      // where the word is in the whole box, to check afterwards that the site followed
      const whole = () => (plain ? field.value : field.textContent).replace(/\u00a0/g, ' ');
      let at = from;
      if (!plain) { const lead = doc.createRange(); lead.selectNodeContents(field); lead.setEnd(node, from); at = lead.toString().length; }
      const before = whole();
      if (before.slice(at, at + word.length) !== word) return;
      const want = before.slice(0, at) + fixed + before.slice(at + word.length, at + word.length + 1);
      // The word and the mark after it are typed over in one go, so the caret ends up after
      // the mark by itself; moving it afterwards is a second change a site could miss.
      const over = fixed + typed;
      if (plain) {
        field.setSelectionRange(from, end);
        if (!this.typeOver(win, field, over)) { field.setSelectionRange(end, end); return; }
      } else {
        const selection = win.getSelection();
        const range = doc.createRange();
        range.setStart(node, from);
        range.setEnd(node, end);
        selection.removeAllRanges();
        selection.addRange(range);
        if (!this.typeOver(win, null, over)) { selection.collapse(node, Math.min(end, node.length)); return; }
      }
      const done = { word: word.toLowerCase(), typed: word + (typed === '\u00a0' ? ' ' : typed), at, field, whole, plain, when: Date.now() };
      this.lastTypo = done;
      // A site that did not follow the change puts the old word back or shows both, at once
      // or within a moment. Its text boxes are then left alone, on this page and on its others.
      const off = () => { this.typosOff = true; this.lastTypo = null; HANDS_OFF.add(doc.location.host); };
      if (!whole().startsWith(want)) { off(); return; }
      setTimeout(() => {
        try { if (this.lastTypo === done && field.isConnected && !fixed.startsWith(word) && whole().slice(at, at + word.length) === word) off(); } catch {}
      }, 150);
    } catch {}
  }

  // Ctrl Z, in a box where a word was just put right. The engine's own undo says so
  // (historyUndo); editors with their own undo only show it in the text, so the key is
  // watched as well. A word put back this way is kept as typed from then on, and the caret
  // goes back after it (undoing leaves the word selected, where the next key would replace it).
  typoKey(event) {
    const last = this.lastTypo;
    if (!last || Date.now() - last.when > 15000 || !(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey || String(event.key).toLowerCase() !== 'z') return;
    setTimeout(() => this.typoUndone(), 0);
  }

  typoUndone() {
    try {
      const last = this.lastTypo;
      if (!last || Date.now() - last.when > 15000 || !last.field.isConnected) return;
      if (last.whole().slice(last.at, last.at + last.typed.length) !== last.typed) return;
      (this.typosKept ||= new Set()).add(last.word);
      this.lastTypo = null;
      const field = last.field;
      if (last.plain) {
        if (field.selectionStart !== field.selectionEnd) field.setSelectionRange(field.selectionEnd, field.selectionEnd);
      } else {
        const selection = field.ownerDocument.defaultView.getSelection();
        if (selection && !selection.isCollapsed && field.contains(selection.anchorNode) && selection.toString().replace(/\u00a0/g, ' ') === last.typed) selection.collapseToEnd();
      }
    } catch {}
  }

  // Replaces the selected text the way typing would, through the engine's own editor: the
  // page is told (input events), and it is one step in the box's undo history.
  typeOver(win, field, text) {
    try {
      const editor = field ? field.editor : win.docShell.editingSession.getEditorForWindow(win);
      if (editor) { editor.insertText(text); return true; }
    } catch {}
    try { return win.document.execCommand('insertText', false, text); } catch { return false; }
  }

  // Whether a text box is one where typing slips may be put right.
  typoField(field) {
    const tag = field.localName;
    if (tag === 'input') { if (!['', 'text'].includes(String(field.getAttribute('type') || '').toLowerCase())) return false; }
    else if (tag !== 'textarea' && !field.isContentEditable) return false;
    if (field.readOnly || field.disabled) return false;
    // spelling help switched off by the site, on the box or around it (the engine's own default
    // for one-line boxes is off, so the attribute is what counts, not the property)
    if (/^false$/i.test(String(field.closest?.('[spellcheck]')?.getAttribute('spellcheck') || ''))) return false;
    const off = name => /^(off|false|none)$/i.test(String(field.getAttribute(name) || ''));
    if (off('autocorrect') || off('autocapitalize')) return false;
    // not prose: sign-in and payment boxes, addresses, numbers, codes; and search boxes, where
    // names and odd spellings are looked for on purpose and the site has its own "did you mean"
    const said = names => names.map(name => field.getAttribute(name) || '').join(' ').toLowerCase();
    if (/user|login|e-?mail|pass|pwd|otp|\bcode\b|token|\bkey\b|url|link|domain|host|numeric|decimal|\btel\b|phone|card|iban|promo|coupon|search|query|\bq\b/.test(said(['autocomplete', 'inputmode', 'name', 'id']))) return false;
    if (/\b(user ?name|e-?mail|password|passcode|search|otp|verification code|promo code|coupon)\b/.test(said(['aria-label', 'placeholder']))) return false;
    if (/^(searchbox|combobox|spinbutton)$/i.test(String(field.getAttribute('role') || ''))) return false;
    // code and terminals
    if (field.closest?.('.monaco-editor, .CodeMirror, .cm-editor, .ace_editor, .xterm, pre, code, [role="code"], [data-language]')) return false;
    // a page or a box that says it is not in English: the list is English only
    const lang = String(field.closest?.('[lang]')?.getAttribute('lang') || field.ownerDocument.documentElement.getAttribute('lang') || '').trim().toLowerCase();
    if (lang && !/^en\b/.test(lang)) return false;
    // document editors that draw their own page and have their own autocorrect: what is
    // typed there goes into a hidden box that only stands in for the keyboard
    if (/(^|\.)docs\.google\.com$|(^|\.)officeapps\.live\.com$/.test(field.ownerDocument.location.hostname)) return false;
    const size = field.getBoundingClientRect();
    if (size.width < 24 || size.height < 10) return false;
    if (field.ownerDocument.defaultView.getComputedStyle(field).opacity === '0') return false;
    return true;
  }

  handleEvent(event) {
    if (event.type === 'input') { this.fixTypo(event); return; }
    if (event.type === 'keydown') { this.typoKey(event); return; }
    if (event.type === 'MozInvalidForm') { this.reportInvalid(event.detail); return; }
    if (event.type === 'DOMContentLoaded' && event.target === this.document) { this.darken(); this.watchGestures(); }
    if (event.type === 'load') this.darken();
    if (event.type === 'DOMWindowCreated') { this.exposeBrowseryPage(); if (this.webOnlyGoogle()) return; this.protect(); this.skinGoogle(); this.applyHidden(); }
    else if (event.type === 'DOMContentLoaded' && event.target === this.document) { this.protect(); this.skinGoogle(); this.recolorGoogle(); this.stripGoogle(); this.reportLoaded(); this.watchLogins(); this.watchLinks(); }
    else if (event.type === 'pageshow' && event.persisted) this.reportLoaded();
  }

  // Google results get Browsery's look (see google-skin.sys.mjs). Top frame
  // only; switch off with the browsery.content.googleSkin preference.
  skinGoogle() {
    if (this.skinned || this.browsingContext.parent) return;
    const win = this.contentWindow;
    if (!win || !isGoogleSearch(win)) return;
    try { if (!Services.prefs.getBoolPref('browsery.content.googleSkin', true)) return; } catch { return; }
    this.skinned = true;
    try { win.windowUtils.loadSheetUsingURIString(`data:text/css;charset=utf-8,${encodeURIComponent(GOOGLE_SKIN)}`, Ci.nsIDOMWindowUtils.USER_SHEET); } catch (error) { Cu.reportError?.(error); }
  }

  // Google shows only web results, Images and Videos (see google-skin.sys.mjs):
  // searches are sent to its plain "Web" view, then leftover blocks and tabs are
  // hidden. Top frame only; switch off with browsery.content.googleStrip.
  webOnlyGoogle() {
    if (this.browsingContext.parent) return false;
    const win = this.contentWindow;
    if (!win) return false;
    try { if (!Services.prefs.getBoolPref('browsery.content.googleStrip', true)) return false; } catch { return false; }
    const target = webOnlyUrl(win);
    if (!target) return false;
    try { win.location.replace(target); return true; } catch (error) { Cu.reportError?.(error); return false; }
  }

  stripGoogle() {
    if (this.stripped || this.browsingContext.parent) return;
    const win = this.contentWindow;
    if (!win || !isGoogleSearch(win) || !win.document?.documentElement) return;
    try { if (!Services.prefs.getBoolPref('browsery.content.googleStrip', true)) return; } catch { return; }
    this.stripped = true;
    try { Cu.evalInSandbox(`{ ${PAGE_BUILTINS} (() => { try {${GOOGLE_STRIP}} catch (e) {} })(); }`, this.pageSandbox, null, 'browsery-google-strip', 1); } catch (error) { Cu.reportError?.(error); }
  }

  // The recolouring needs the document's body; it runs once the page has loaded.
  recolorGoogle() {
    if (this.recolored || this.browsingContext.parent) return;
    const win = this.contentWindow;
    if (!win || !isGoogleSearch(win) || !win.document?.documentElement) return;
    try { if (!Services.prefs.getBoolPref('browsery.content.googleSkin', true)) return; } catch { return; }
    this.recolored = true;
    try { Cu.evalInSandbox(`{ ${PAGE_BUILTINS} (() => { try {${GOOGLE_RECOLOR}} catch (e) {} })(); }`, this.pageSandbox, null, 'browsery-google-skin', 1); } catch (error) { Cu.reportError?.(error); }
  }

  protect() {
    if (this.protectedPage) return;
    this.protectedPage = true;
    const win = this.contentWindow;
    if (!win) return;
    let host = '';
    let protocol = '';
    try { host = win.location.hostname.toLowerCase(); protocol = win.location.protocol; } catch {}
    if (protocol !== 'http:' && protocol !== 'https:') return;
    if (!adblockOn(host)) return;
    const youtube = YT_HOST.test(host);
    const css = `${(youtube ? GENERIC_HIDE.concat(YOUTUBE_HIDE) : GENERIC_HIDE).join(',\n')} { display: none !important; }`;
    try { win.windowUtils.loadSheetUsingURIString(`data:text/css;charset=utf-8,${encodeURIComponent(css)}`, Ci.nsIDOMWindowUtils.USER_SHEET); } catch {}
    const parts = [ANTI_DETECTION];
    if (youtube) parts.push(YOUTUBE);
    try { Cu.evalInSandbox(`{ ${PAGE_BUILTINS} (() => { try {${PRELUDE}${parts.join('\n')}} catch (e) {} })(); }`, this.pageSandbox, null, 'browsery-protection', 1); } catch (error) { Cu.reportError?.(error); }
  }

  reportLoaded() {
    if (this.browsingContext.parent) return;
    const doc = this.document;
    let icons = [];
    try { icons = [...doc.querySelectorAll('link[rel~="icon" i]')].map(link => link.href).filter(Boolean).slice(0, 6); } catch {}
    this.sendAsyncMessage('Browsery:Loaded', { icons, title: String(doc.title || '').slice(0, 512) });
  }

  async receiveMessage(message) {
    const win = this.contentWindow;
    switch (message.name) {
      case 'Browsery:Exec': {
        let result = Cu.evalInSandbox(String(message.data.code), this.pageSandbox, null, 'browsery-exec', 1);
        if (result && typeof result.then === 'function') result = await result;
        if (result === undefined) return null;
        try { return JSON.parse(JSON.stringify(result)); } catch { return null; }
      }
      case 'Browsery:InsertCSS': {
        const key = `css-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
        const uri = `data:text/css;charset=utf-8,${encodeURIComponent(String(message.data.css))}`;
        win.windowUtils.loadSheetUsingURIString(uri, Ci.nsIDOMWindowUtils.AUTHOR_SHEET);
        this.sheets.set(key, uri);
        return key;
      }
      case 'Browsery:Darken': {
        // { on: true | false } from the page menu; null re-reads the settings.
        const on = message.data?.on;
        this.darken(on === null || on === undefined ? undefined : Boolean(on));
        return { darkened: Boolean(this.darkened), light: this.pageIsLight() };
      }
      case 'Browsery:Pick':
        if (message.data?.on === false) { this.stopPicker(); return { ok: true }; }
        return this.startPicker();
      case 'Browsery:HiddenRefresh':
        this.applyHidden(this.picker ? this.picker.added.filter(rule => this.hiddenFor(this.siteName(), message.data?.all).includes(rule)) : [], message.data?.all || null);
        return true;
      case 'Browsery:VideoInfo': {
        const video = this.findVideo();
        if (!video) return null;
        const r = video.getBoundingClientRect();
        return { width: video.videoWidth || Math.round(r.width), height: video.videoHeight || Math.round(r.height), paused: video.paused, time: video.currentTime, duration: Number.isFinite(video.duration) ? video.duration : 0, rect: [r.left, r.top, r.width, r.height] };
      }
      case 'Browsery:VideoControl': {
        const video = this.findVideo();
        if (!video) return null;
        const what = String(message.data?.what || '');
        if (what === 'toggle') { if (video.paused) video.play().catch(() => {}); else video.pause(); }
        else if (what === 'seek') video.currentTime = Math.max(0, video.currentTime + (Number(message.data?.by) || 0));
        return { paused: video.paused };
      }
      case 'Browsery:RemoveCSS': {
        const uri = this.sheets.get(String(message.data.key));
        if (uri) { try { win.windowUtils.removeSheetUsingURIString(uri, Ci.nsIDOMWindowUtils.AUTHOR_SHEET); } catch {} this.sheets.delete(String(message.data.key)); }
        return true;
      }
      default:
        return null;
    }
  }
}
