// Two words run together, and contractions typed without their apostrophe.
const PHRASES = `
alot:a lot aswell:as well atleast:at least infact:in fact eachother:each other
youre:you're theyre:they're doesnt:doesn't didnt:didn't isnt:isn't wasnt:wasn't
couldnt:couldn't shouldnt:shouldn't wouldnt:wouldn't havent:haven't hasnt:hasn't arent:aren't werent:weren't
thats:that's whats:what's dosen't:doesn't
`;

export const TYPOS = new Map();
for (const pair of LIST.split(/\s+/)) { const at = pair.indexOf(':'); if (at > 0) TYPOS.set(pair.slice(0, at), pair.slice(at + 1)); }
for (const line of PHRASES.split('\n')) for (const pair of line.trim().split(/\s+(?=[a-z']+:)/)) { const at = pair.indexOf(':'); if (at > 0) TYPOS.set(pair.slice(0, at), pair.slice(at + 1)); }

// The word put right, or null when there is nothing to do. Only plain lower-case words, or
// ones with just their first letter a capital, are looked at (so NASA, iPhone and h2o are
// left alone); a capital first letter is kept.
export function fixWord(word) {
  const text = String(word || '');
  if (text.length < 3 || text.length > 24 || !/^[A-Za-z][a-z']*$/.test(text)) return null;
  const fixed = TYPOS.get(text.toLowerCase());
  if (!fixed) return null;
  return /^[A-Z]/.test(text) && /^[a-z]/.test(fixed) ? fixed[0].toUpperCase() + fixed.slice(1) : fixed;
}

// A line of text (a search) with its slips put right, or null when it has none.
export function fixText(text) {
  let changed = false;
  const out = String(text || '').replace(/[A-Za-z][A-Za-z']*/g, word => {
    const fixed = fixWord(word);
    if (!fixed) return word;
    changed = true;
    return fixed;
  });
  return changed ? out : null;
}
