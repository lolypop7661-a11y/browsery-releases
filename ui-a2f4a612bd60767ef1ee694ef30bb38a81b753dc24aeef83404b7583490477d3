  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  [hidden]{display:none!important}

  /* Header: brand, search pill, category tabs */
  .hero{background:var(--bg);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;gap:30px;padding:14px 24px 0;min-height:80px}
  .brand{flex:0 0 150px;display:inline-flex;align-items:center;gap:9px;color:var(--text);text-decoration:none;font-size:24px;font-weight:700;letter-spacing:-.04em;white-space:nowrap}
  .brand svg{width:30px;height:30px;flex:0 0 30px}
  .search-form{flex:0 1 690px;min-width:0;display:flex;align-items:center;height:52px;padding:0 8px 0 22px;border:1px solid transparent;border-radius:26px;background:var(--surface);transition:box-shadow .15s,background .15s}
  .search-form:hover{background:#35363a}
  .search-form:focus-within{background:#35363a;box-shadow:0 1px 6px rgba(0,0,0,.45)}
  .search-form input[name=q]{flex:1;min-width:0;height:50px;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:16px}
  .search-form input::placeholder{color:var(--muted)}
  .search-form .clear,.search-form .go{flex:0 0 auto;width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:50%;background:transparent;color:var(--text-2);cursor:pointer}
  .search-form .clear:hover,.search-form .go:hover{background:rgba(255,255,255,.08)}
  .search-form .go{color:var(--accent)}
  .search-form .rule{flex:0 0 1px;height:24px;margin:0 6px;background:var(--line)}
  .search-form svg{width:22px;height:22px}
  .search-form .clear[hidden]+.rule{display:none}
  .search-tabs{display:flex;align-items:flex-end;gap:2px;margin:0;padding:0 24px 0 calc(var(--lead) + 16px);overflow-x:auto;scrollbar-width:none}
  .search-tabs::-webkit-scrollbar{display:none}
  .search-tabs a{flex:0 0 auto;position:relative;height:48px;padding:0 14px;display:flex;align-items:center;color:var(--muted);font-size:14px;text-decoration:none;white-space:nowrap}
  .search-tabs a:hover{color:var(--text)}
  .search-tabs a.active{color:var(--text);font-weight:600}
  .search-tabs a.active:after{content:"";position:absolute;left:8px;right:8px;bottom:0;height:3px;border-radius:3px 3px 0 0;background:var(--text)}

  /* Content column */
  .layout{display:block;max-width:none;margin:0;padding:18px 24px 90px calc(var(--lead) + 16px)}
  .layout>section{max-width:652px;min-width:0}
  .side{display:none}
  .result-stats{display:flex;flex-wrap:wrap;gap:0 10px;margin:0 0 6px;color:var(--muted);font-size:13px}
  .result-stats #search-provider:before{content:"\xB7";margin-right:10px}
  #mwmbl-credit{margin:0 0 6px!important;color:var(--muted)!important;font-size:12px!important}
  #mwmbl-credit a{color:var(--text-2)!important}

  /* AI Overview */
  .ai{margin:6px 0 22px;padding:0 0 22px;border-bottom:1px solid var(--line)}
  .ai-head{display:flex;align-items:center;gap:10px;margin:0 0 14px;color:var(--text);font-size:14px}
  .ai-head svg{width:22px;height:22px;flex:0 0 22px}
  .ai-head small{margin-left:auto;color:var(--muted);font-size:12px}
  .ai-body{color:var(--text);font-size:16px;line-height:24px;white-space:pre-wrap;overflow-wrap:anywhere}
  .ai-body.clamped{max-height:168px;overflow:hidden;-webkit-mask-image:linear-gradient(#000 72%,transparent);mask-image:linear-gradient(#000 72%,transparent)}
  .ai-notice{display:block;margin-top:10px;color:var(--muted);font-size:12px}
  .ai-sources{margin-top:14px}
  .ai-sources summary{color:var(--text-2);cursor:pointer;font-size:13px}
  .ai-sources>div{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .chip{display:inline-flex;align-items:center;max-width:100%;padding:6px 12px;border:1px solid var(--line);border-radius:16px;color:var(--text-2);font-size:12px;text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chip:hover{background:rgba(255,255,255,.06);color:var(--text)}
  .pill{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:48px;margin-top:20px;border:1px solid var(--line);border-radius:24px;background:transparent;color:var(--text);font-size:14px;cursor:pointer}
  .pill:hover{background:rgba(255,255,255,.06)}
  .pill svg{width:18px;height:18px;transition:transform .2s}
  .pill[aria-expanded=true] svg{transform:rotate(180deg)}
  .pill.retry{display:inline-flex;width:auto;height:36px;padding:0 18px;margin-top:14px}

  /* Web results */
  .result{padding:0 0 28px;animation:arrive .28s cubic-bezier(.2,.75,.25,1) both}
  .result:nth-of-type(2){animation-delay:30ms}.result:nth-of-type(3){animation-delay:60ms}.result:nth-of-type(4){animation-delay:90ms}.result:nth-of-type(5){animation-delay:120ms}
  .result-site{display:flex;align-items:center;gap:12px;margin:0 0 6px;min-width:0}
  .site-logo{position:relative;flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden}
  .site-logo img{position:absolute;inset:6px;width:16px;height:16px;object-fit:contain}
  .site-logo b{color:#3c4043;font-size:12px;font-weight:700}
  .site-meta{min-width:0;display:flex;flex-direction:column;line-height:1.3}
  .site-meta strong{color:#dadce0;font-size:14px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .site-meta small{color:var(--text-2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .result-number{display:none}
  .result-title{display:inline-block;margin:0 0 3px;color:var(--link);font-size:20px;line-height:1.3;font-weight:400;text-decoration:none}
  .result-title:visited{color:var(--visited)}
  .result-title:hover{text-decoration:underline}
  .result p{max-width:600px;margin:0;color:var(--text-2);font-size:14px;line-height:1.57}
  .more-results{min-height:48px;margin:6px 0 26px}
  .more-results p{margin:0;color:var(--muted);font-size:13px}
  .more-results button,.image-more button{height:40px;margin-top:12px;padding:0 22px;border:1px solid var(--line);border-radius:20px;background:transparent;color:var(--text);cursor:pointer}
  .more-results button:hover,.image-more button:hover{background:rgba(255,255,255,.06)}
  .more-results button[hidden],.image-more button[hidden]{display:none}
  #results-sentinel,#images-sentinel{height:2px}
  .search-skeleton{display:grid;gap:10px;padding:8px 0 24px}
  .search-skeleton i,.search-skeleton b,.search-skeleton span{display:block;border-radius:999px;background:linear-gradient(100deg,#2a2b2e 20%,#3a3b3f 45%,#2a2b2e 70%);background-size:220% 100%;animation:sheen 1.35s ease-in-out infinite}
  .search-skeleton i{width:28px;height:28px}.search-skeleton b{width:min(410px,72%);height:18px}.search-skeleton span{width:min(600px,92%);height:12px;margin-bottom:16px}.search-skeleton span:nth-of-type(2){width:75%}.search-skeleton span:nth-of-type(3){width:84%}
  .empty{padding:8px 0 24px;border:0;background:transparent}
  .empty strong{display:block;margin-bottom:6px;color:var(--text);font-size:18px;font-weight:400}
  .empty p{max-width:560px;margin:0 0 14px;color:var(--text-2);font-size:14px}
  .empty .search-retry,.empty .search-alternative{display:inline-flex;margin:0 10px 10px 0;padding:8px 16px;border:1px solid var(--line);border-radius:18px;color:var(--text);font-size:13px;text-decoration:none}
  .empty .search-retry:hover,.empty .search-alternative:hover{background:rgba(255,255,255,.06)}

  /* Images */
  .visual-section{margin:4px 0 26px;padding:0 0 22px;border-bottom:1px solid var(--line)}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 12px}
  .section-heading h2{margin:0;color:var(--text);font-size:22px;font-weight:400;line-height:28px}
  .section-heading p{margin:2px 0 0;color:var(--muted);font-size:13px}
  .section-heading>a{color:var(--link);font-size:14px;text-decoration:none;white-space:nowrap}
  .section-heading>a:hover{text-decoration:underline}
  .image-grid{display:grid;gap:14px}
  .image-grid-preview{grid-template-columns:repeat(3,minmax(0,1fr))}
  .image-grid-full{grid-template-columns:repeat(4,minmax(0,1fr));row-gap:22px}
  .image-card{display:block;min-width:0;border:0;border-radius:12px;overflow:hidden;background:transparent;color:inherit;text-decoration:none}
  .image-frame{position:relative;display:block;aspect-ratio:1.4;border-radius:12px;background:var(--surface);overflow:hidden}
  .image-grid-full .image-frame{aspect-ratio:1.2}
  .image-frame img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .35s cubic-bezier(.25,1,.5,1)}
  .image-card:hover .image-frame img{transform:scale(1.04)}
  .image-open{position:absolute;right:8px;top:8px;width:26px;height:26px;display:grid;place-items:center;border-radius:50%;background:rgba(32,33,36,.8);color:var(--text);font-size:13px;opacity:0;transition:opacity .15s}
  .image-card:hover .image-open,.image-card:focus-visible .image-open{opacity:1}
  .image-caption{display:none;padding:8px 2px 0}
  .image-grid-full .image-caption{display:block}
  .image-caption strong{display:block;overflow:hidden;color:var(--text);font-size:13px;font-weight:400;text-overflow:ellipsis;white-space:nowrap}
  .image-caption small{display:block;overflow:hidden;color:var(--muted);font-size:12px;text-overflow:ellipsis;white-space:nowrap}
  .image-credit{margin:14px 0 0;color:var(--muted);font-size:12px}
  .image-empty{grid-column:1/-1;min-height:140px;border:1px dashed var(--line);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--muted);font-size:13px}
  .image-empty strong{color:var(--text);font-size:15px;font-weight:400}
  .image-empty-mark{font-size:22px;color:var(--accent)}
  .image-more{min-height:40px;margin:16px 0 4px}
  .image-more p{margin:0;color:var(--muted);font-size:13px}
  .layout:has(.image-grid-full)>section{max-width:1100px}
  .layout:has(.image-grid-full) .visual-section{margin-bottom:0;padding-bottom:0;border-bottom:0}

  @keyframes arrive{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes sheen{to{background-position:-220% 0}}
  @media(prefers-reduced-motion:reduce){.result{animation:none}.search-skeleton i,.search-skeleton b,.search-skeleton span{animation:none}}
  @media(max-width:1100px){:root{--lead:0px}.bar{gap:16px}.brand{flex-basis:auto}.search-tabs,.layout{padding-left:24px}.image-grid-full{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:700px){:root{--lead:0px}.bar{flex-wrap:wrap;gap:10px;padding:12px 16px 0;min-height:0}.brand{flex:1 0 100%}.search-form{flex:1 0 100%;height:46px;padding-left:18px}.search-form input[name=q]{height:44px;font-size:16px}.search-tabs{padding:6px 8px 0}.search-tabs a{height:44px;padding:0 12px}.layout{padding:16px 16px 60px}.result-title{font-size:18px}.image-grid-preview,.image-grid-full{grid-template-columns:repeat(2,minmax(0,1fr))}.image-grid-preview .image-card:nth-child(3){display:none}}
