          host = browser.currentURI.host.replace(/^www\./, "");
        } catch {
        }
        if (!actor || !host) return { ok: false };
        const state = await actor.sendQuery("Browsery:Darken", { on: null }).catch(() => null);
        const next = !state?.darkened;
        const edit = (name, add) => {
          let list = [];
          try {
            list = Services.prefs.getStringPref(name, "").split(",").filter(Boolean);
          } catch {
          }
          list = list.filter((item) => item !== host);
          if (add) list.push(host);
          Services.prefs.setStringPref(name, list.slice(-500).join(","));
        };
        edit("browsery.content.darkOn", next);
        edit("browsery.content.darkOff", !next);
